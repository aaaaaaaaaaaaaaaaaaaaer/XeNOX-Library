local XeNOX = {}
local tabs = {}
local tabCount = 0

function XeNOX:CreateTab(name)
    tabCount = tabCount + 1
    local tabID = tabCount
    
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0, 140, 0, 40)
    tabBtn.Position = UDim2.new(0, 10, 0, 40 + (tabCount - 1) * 45)
    tabBtn.BackgroundColor3 = Color3.fromRGB(25, 55, 95)
    tabBtn.Text = name
    tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    tabBtn.TextSize = 16
    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.Parent = mainFrame
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 4)

    local contentFrame = Instance.new("Frame")
    contentFrame.Size = UDim2.new(0, 800, 0, 680)
    contentFrame.Position = UDim2.new(0, 165, 0, 45)
    contentFrame.BackgroundTransparency = 1
    contentFrame.Visible = (tabID == 1)
    contentFrame.Parent = mainFrame
    
    local tabObj = {Frame = contentFrame, Btn = tabBtn, Count = 0}
    tabs[tabID] = tabObj

    tabBtn.MouseButton1Click:Connect(function()
        for _, v in pairs(tabs) do v.Frame.Visible = false end
        contentFrame.Visible = true
    end)

    function tabObj:CreateButton(text, callback)
        tabObj.Count = tabObj.Count + 1
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 780, 0, 40)
        b.Position = UDim2.new(0, 0, 0, (tabObj.Count - 1) * 45)
        b.BackgroundColor3 = Color3.fromRGB(25, 55, 95)
        b.Text = text
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.TextSize = 16
        b.Font = Enum.Font.SourceSansBold
        b.Parent = contentFrame
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
        b.MouseButton1Click:Connect(callback)
    end

    return tabObj
end

