-- ULTRA SENSITIVE REPULSION BLOBS
task.spawn(function()
    while task.wait(0.05) do -- Insanely fast spawn rate
        local blob = Instance.new("ImageLabel")
        local size = math.random(3, 7) / 10
        blob.Size = UDim2.new(size, 0, size, 0)
        blob.Position = UDim2.new(math.random(-1, 9)/10, 0, math.random(-1, 9)/10, 0)
        blob.Image = "rbxassetid://232918622"
        blob.ImageColor3 = Color3.fromRGB(0, 20, 100)
        blob.BackgroundTransparency = 1
        blob.ImageTransparency = 0.9 -- Very transparent
        blob.ZIndex = 1
        blob.Parent = mainFrame

        task.spawn(function()
            local life = 5
            local startTick = tick()
            while tick() - startTick < life do
                local blobPos = Vector2.new(blob.AbsolutePosition.X + (blob.AbsoluteSize.X/2), blob.AbsolutePosition.Y + (blob.AbsoluteSize.Y/2))
                local mousePos = Vector2.new(mouse.X, mouse.Y)
                local diff = blobPos - mousePos
                local dist = diff.Magnitude
                
                -- Repulsion Logic: Move AWAY from mouse
                if dist < 200 then
                    local force = (1 - (dist / 200)) * 0.05 -- Stronger force the closer it is
                    local pushDir = diff.Unit
                    
                    local newX = blob.Position.X.Scale + (pushDir.X * force)
                    local newY = blob.Position.Y.Scale + (pushDir.Y * force)
                    
                    blob.Position = blob.Position:Lerp(UDim2.new(newX, 0, newY, 0), 0.2)
                    blob.ImageTransparency = 0.95 -- Fade out even more when pushed
                else
                    blob.ImageTransparency = 0.9 -- Normal transparency
                end
                
                task.wait()
            end
            blob:Destroy()
        end)
    end
end)

